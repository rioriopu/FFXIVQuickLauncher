<Window x:Class="XIVLauncher.Windows.RuntimeRepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XIVLauncher - ランタイムの確認・修復" Width="720" Height="590"
        MinWidth="660" MinHeight="540" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="ランタイムの確認・修復" FontSize="20" FontWeight="Bold"/>
            <TextBlock TextWrapping="Wrap" Margin="0,10,0,12"
                       Text="起動時の警告に表示された .NET の系列を選んでください。Windows に導入された x64 版を確認します。新しい系列を入れても、古い系列の代わりにはなりません。"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="確認する系列" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <ComboBox x:Name="Channel" Width="240" SelectedIndex="0" SelectionChanged="Channel_SelectionChanged">
                <ComboBoxItem Content=".NET 6（互換用・サポート終了）" Tag="6.0"/>
                <ComboBoxItem Content=".NET 8" Tag="8.0"/>
                <ComboBoxItem Content=".NET 9" Tag="9.0"/>
            </ComboBox>
        </StackPanel>
        <TextBlock x:Name="InstalledStatus" Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="3" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="DarkGray"
                   Text="「修復」を押すと、Microsoft 公式の Desktop Runtime（.NET Runtime を含む）を取得し、検証後にインストーラーを開きます。画面の案内に従ってください。既存の別系列は削除しません。Dalamud 専用のランタイムは、ゲーム起動時に別途確認されます。"/>
        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RepairButton" Content="修復（公式インストーラーを取得）" Click="Repair_Click" Padding="12,6"/>
                <Button x:Name="RefreshButton" Content="再確認" Click="Refresh_Click" Margin="12,0,0,0" Padding="12,6"/>
            </StackPanel>
            <ProgressBar x:Name="DownloadProgress" Height="5" Minimum="0" Maximum="100" Margin="0,12,0,0"/>
        </StackPanel>
        <TextBox x:Name="Trace" Grid.Row="5" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" MinHeight="80"/>
        <TextBlock Grid.Row="6" Margin="0,12,0,0" Foreground="DarkGray" TextWrapping="Wrap"
                   Text="警告を出しているアプリの保存先や設定によっては、別の対応が必要です。インストール後は該当アプリを起動し直してください。"/>
    </Grid>
</Window>
